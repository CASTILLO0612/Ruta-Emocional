{
  "expo": {
    "name": "Ruta Emocional",
    "slug": "ruta-emocional",
    "scheme": "rutaemocional",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#253A82",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rutaemocional.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#253A82"
      },
      "package": "com.rutaemocional.app"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-font",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": { "audioType": "communication" },
          "ios": { "enableMultitaskingCameraAccess": false }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Ruta Emocional usa la cámara durante una videollamada que tú inicies o aceptes.",
          "microphonePermission": "Ruta Emocional usa el micrófono durante una llamada que tú inicies o aceptes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#253A82",
          "defaultChannel": "ruta-emocional"
        }
      ],
      "./plugins/withGoogleNavigationSdk",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#253A82"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Ruta Emocional",
      "shortName": "Ruta",
      "lang": "es",
      "themeColor": "#253A82",
      "backgroundColor": "#F8FAFC"
    },
    "extra": {
      "eas": {
        "projectId": "6ac126af-e664-4d91-912a-264560e06f61"
      }
    },
    "owner": "castillo109b"
  }
}
