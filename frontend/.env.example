# Origen del backend, sin el sufijo /api. En producción debe usar HTTPS.
# Android Emulator suele requerir la dirección del host en lugar de localhost.
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_DIRECTORY_RADIUS_KM=25
EXPO_PUBLIC_MAP_LATITUDE_DELTA=0.04
EXPO_PUBLIC_MAP_LONGITUDE_DELTA=0.04
EXPO_PUBLIC_REQUEST_POLL_INTERVAL_MS=5000
EXPO_PUBLIC_TRIAGE_COUNTRY_CODE=NI
