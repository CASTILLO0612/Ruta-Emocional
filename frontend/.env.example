# Origen del backend, sin el sufijo /api. En producción debe usar HTTPS.
# Android Emulator suele requerir la dirección del host en lugar de localhost.
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_DIRECTORY_RADIUS_KM=25
EXPO_PUBLIC_MAP_LATITUDE_DELTA=0.04
EXPO_PUBLIC_MAP_LONGITUDE_DELTA=0.04
EXPO_PUBLIC_DEFAULT_MAP_LATITUDE=12.1328
EXPO_PUBLIC_DEFAULT_MAP_LONGITUDE=-86.2904
EXPO_PUBLIC_REQUEST_POLL_INTERVAL_MS=5000
EXPO_PUBLIC_TRIAGE_COUNTRY_CODE=NI
# ID OAuth 2.0 de tipo "Aplicación web"; no uses aquí el cliente Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
GOOGLE_NAVIGATION_API_KEY=
# Identificador UUID del proyecto EAS utilizado para generar ExpoPushToken.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Ruta local al google-services.json de Firebase. Nunca subir el archivo al repositorio.
GOOGLE_SERVICES_FILE=./google-services.json
