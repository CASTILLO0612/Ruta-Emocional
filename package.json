{
  "name": "ruta-emocional-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start:frontend": "cd frontend && npx expo start --web",
    "start:backend": "cd backend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "db:validate": "cd backend && npm run db:validate",
    "db:generate": "cd backend && npm run db:generate",
    "db:migrate:dev": "cd backend && npm run db:migrate:dev",
    "db:migrate:deploy": "cd backend && npm run db:migrate:deploy"
  }
}
