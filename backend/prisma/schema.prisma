generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("account_status")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum VerificationDecision {
  APPROVED
  REJECTED

  @@map("verification_decision")
}

enum Modality {
  CHAT
  CALL
  IN_PERSON

  @@map("modality")
}

enum RequestStatus {
  PENDING
  BIDDING
  ACCEPTED
  IN_SESSION
  COMPLETED
  CANCELLED
  EXPIRED

  @@map("request_status")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN

  @@map("offer_status")
}

enum CareRelationshipStatus {
  ACTIVE
  PAUSED
  ENDED

  @@map("care_relationship_status")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum AppointmentEventType {
  CREATED
  STATUS_CHANGED
  RESCHEDULED

  @@map("appointment_event_type")
}

enum AvailabilityExceptionType {
  AVAILABLE
  UNAVAILABLE

  @@map("availability_exception_type")
}

enum ClinicalRecordStatus {
  OPEN
  CLOSED
  ARCHIVED

  @@map("clinical_record_status")
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
  AMENDED

  @@map("clinical_note_status")
}

enum DiagnosisStatus {
  PROVISIONAL
  CONFIRMED
  RULED_OUT
  RESOLVED

  @@map("diagnosis_status")
}

enum TreatmentPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED

  @@map("treatment_plan_status")
}

enum TreatmentGoalStatus {
  PENDING
  IN_PROGRESS
  ACHIEVED
  CANCELLED

  @@map("treatment_goal_status")
}

enum ConsentDecision {
  GRANTED
  WITHDRAWN

  @@map("consent_decision")
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  SYSTEM

  @@map("message_type")
}

enum PaymentStatus {
  PENDING
  HELD
  COMPLETED
  REFUNDED
  FAILED

  @@map("payment_status")
}

enum TriageRiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL

  @@map("triage_risk_level")
}

model User {
  id                    String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId              String?                            @unique @map("legacy_id")
  email                 String                             @unique @db.VarChar(320)
  displayName           String                             @map("display_name") @db.VarChar(160)
  passwordHash          String                             @map("password_hash") @db.VarChar(255)
  photoUrl              String?                            @map("photo_url") @db.Text
  phone                 String?                            @db.VarChar(32)
  status                AccountStatus                      @default(ACTIVE)
  createdAt             DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientProfile        PatientProfile?
  psychologistProfile   PsychologistProfile?
  roles                 UserRole[]
  authSessions          AuthSession[]
  conversationMembers   ConversationParticipant[]
  clinicalNoteVersions  ClinicalNoteVersion[]              @relation("ClinicalNoteVersionAuthor")
  auditEvents           AuditEvent[]                       @relation("AuditActor")
  verificationDecisions ProfessionalVerificationDecision[] @relation("VerificationReviewer")
  idempotencyRecords    IdempotencyRecord[]
  appointmentEvents     AppointmentEvent[]                 @relation("AppointmentEventActor")

  @@map("users")
}

model Role {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(255)
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  deviceName       String?   @map("device_name") @db.VarChar(160)
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model PatientProfile {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  birthDate         DateTime?          @map("birth_date") @db.Date
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  serviceRequests   ServiceRequest[]
  careRelationships CareRelationship[]
  appointments      Appointment[]
  clinicalRecord    ClinicalRecord?
  consents          PatientConsent[]
  triageAssessments TriageAssessment[]

  @@map("patient_profiles")
}

model PsychologistProfile {
  id                     String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                                 @unique @map("user_id") @db.Uuid
  verificationStatus     VerificationStatus                     @default(PENDING) @map("verification_status")
  bio                    String?                                @db.Text
  location               Unsupported("geography(Point, 4326)")?
  createdAt              DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                   User                                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  licenses               ProfessionalLicense[]
  specialties            PsychologistSpecialty[]
  modalities             PsychologistModality[]
  offers                 Offer[]
  careRelationships      CareRelationship[]
  appointments           Appointment[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  clinicalEncounters     ClinicalEncounter[]
  clinicalDiagnoses      ClinicalDiagnosis[]
  treatmentPlans         TreatmentPlan[]
  reviewedTriages        TriageAssessment[]                     @relation("TriageReviewer")

  @@index([verificationStatus])
  @@map("psychologist_profiles")
}

model ProfessionalLicense {
  id                      String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  psychologistProfileId   String                               @map("psychologist_profile_id") @db.Uuid
  authority               String                               @db.VarChar(120)
  licenseNumber           String                               @map("license_number") @db.VarChar(80)
  status                  VerificationStatus                   @default(PENDING)
  documentUrl             String?                              @map("document_url") @db.Text
  verifiedAt              DateTime?                            @map("verified_at") @db.Timestamptz(3)
  createdAt               DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  psychologistProfile     PsychologistProfile                  @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  verificationSubmissions ProfessionalVerificationSubmission[]

  @@unique([authority, licenseNumber])
  @@map("professional_licenses")
}

model Specialty {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String                  @unique @db.VarChar(60)
  name          String                  @unique @db.VarChar(120)
  isActive      Boolean                 @default(true) @map("is_active")
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  psychologists PsychologistSpecialty[]

  @@index([isActive, name])
  @@map("specialties")
}

model PsychologistSpecialty {
  psychologistProfileId String              @map("psychologist_profile_id") @db.Uuid
  specialtyId           String              @map("specialty_id") @db.Uuid
  isPrimary             Boolean             @default(false) @map("is_primary")
  psychologistProfile   PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Cascade)
  specialty             Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@id([psychologistProfileId, specialtyId])
  @@map("psychologist_specialties")
}

model PsychologistModality {
  psychologistProfileId String              @map("psychologist_profile_id") @db.Uuid
  modality              Modality
  pricePerHour          Decimal             @map("price_per_hour") @db.Decimal(12, 2)
  currencyCode          String              @map("currency_code") @db.Char(3)
  isEnabled             Boolean             @default(true) @map("is_enabled")
  psychologistProfile   PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Cascade)

  @@id([psychologistProfileId, modality])
  @@map("psychologist_modalities")
}

model ProfessionalVerificationSubmission {
  id                    String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  professionalLicenseId String                            @map("professional_license_id") @db.Uuid
  evidenceObjectKey     String                            @map("evidence_object_key") @db.VarChar(512)
  submittedAt           DateTime                          @default(now()) @map("submitted_at") @db.Timestamptz(3)
  professionalLicense   ProfessionalLicense               @relation(fields: [professionalLicenseId], references: [id], onDelete: Restrict)
  decision              ProfessionalVerificationDecision?

  @@index([professionalLicenseId, submittedAt])
  @@map("professional_verification_submissions")
}

model ProfessionalVerificationDecision {
  id             String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId   String                             @unique @map("submission_id") @db.Uuid
  reviewerUserId String                             @map("reviewer_user_id") @db.Uuid
  decision       VerificationDecision
  publicReason   String?                            @map("public_reason") @db.VarChar(500)
  internalReason String?                            @map("internal_reason") @db.VarChar(1000)
  decidedAt      DateTime                           @default(now()) @map("decided_at") @db.Timestamptz(3)
  submission     ProfessionalVerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewer       User                               @relation("VerificationReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([reviewerUserId, decidedAt])
  @@map("professional_verification_decisions")
}

model ServiceRequest {
  id                     String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId               String?                                @unique @map("legacy_id")
  patientProfileId       String                                 @map("patient_profile_id") @db.Uuid
  modality               Modality
  primaryNeed            String?                                @map("primary_need") @db.VarChar(240)
  description            String?                                @db.Text
  proposedBudget         Decimal                                @map("proposed_budget") @db.Decimal(12, 2)
  currencyCode           String                                 @map("currency_code") @db.Char(3)
  status                 RequestStatus                          @default(PENDING)
  scheduledFor           DateTime?                              @map("scheduled_for") @db.Timestamptz(3)
  expiresAt              DateTime                               @map("expires_at") @db.Timestamptz(3)
  location               Unsupported("geography(Point, 4326)")?
  locationExpiresAt      DateTime?                              @map("location_expires_at") @db.Timestamptz(3)
  createdAt              DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientProfile         PatientProfile                         @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  offers                 Offer[]
  careRelationshipSource CareRelationshipSource?
  appointmentLink        AppointmentRequest?
  conversationLink       RequestConversation?
  triageLinks            RequestTriageAssessment[]

  @@index([status, expiresAt, createdAt])
  @@index([patientProfileId, createdAt])
  @@index([scheduledFor, status])
  @@map("service_requests")
}

model Offer {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId              String?             @unique @map("legacy_id")
  requestId             String              @map("request_id") @db.Uuid
  psychologistProfileId String              @map("psychologist_profile_id") @db.Uuid
  amount                Decimal             @db.Decimal(12, 2)
  message               String?             @db.VarChar(500)
  status                OfferStatus         @default(PENDING)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  request               ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  psychologistProfile   PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  payment               Payment?

  @@unique([requestId, psychologistProfileId])
  @@index([requestId, status])
  @@map("offers")
}

model CareRelationship {
  id                    String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientProfileId      String                        @map("patient_profile_id") @db.Uuid
  psychologistProfileId String                        @map("psychologist_profile_id") @db.Uuid
  status                CareRelationshipStatus        @default(ACTIVE)
  startedAt             DateTime                      @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt               DateTime?                     @map("ended_at") @db.Timestamptz(3)
  patientProfile        PatientProfile                @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  psychologistProfile   PsychologistProfile           @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  source                CareRelationshipSource?
  appointments          AppointmentCareRelationship[]

  @@index([patientProfileId, psychologistProfileId, status])
  @@map("care_relationships")
}

model CareRelationshipSource {
  careRelationshipId String           @id @map("care_relationship_id") @db.Uuid
  serviceRequestId   String           @unique @map("service_request_id") @db.Uuid
  careRelationship   CareRelationship @relation(fields: [careRelationshipId], references: [id], onDelete: Cascade)
  serviceRequest     ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@map("care_relationship_sources")
}

model AvailabilityRule {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  psychologistProfileId String              @map("psychologist_profile_id") @db.Uuid
  weekday               Int                 @db.SmallInt
  startTime             DateTime            @map("start_time") @db.Time(0)
  endTime               DateTime            @map("end_time") @db.Time(0)
  timezone              String              @db.VarChar(80)
  effectiveFrom         DateTime?           @map("effective_from") @db.Date
  effectiveUntil        DateTime?           @map("effective_until") @db.Date
  isActive              Boolean             @default(true) @map("is_active")
  psychologistProfile   PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Cascade)

  @@index([psychologistProfileId, weekday, isActive])
  @@map("availability_rules")
}

model AvailabilityException {
  id                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  psychologistProfileId String                    @map("psychologist_profile_id") @db.Uuid
  startsAt              DateTime                  @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime                  @map("ends_at") @db.Timestamptz(3)
  type                  AvailabilityExceptionType
  reason                String?                   @db.VarChar(240)
  psychologistProfile   PsychologistProfile       @relation(fields: [psychologistProfileId], references: [id], onDelete: Cascade)

  @@index([psychologistProfileId, startsAt, endsAt])
  @@map("availability_exceptions")
}

model Appointment {
  id                    String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientProfileId      String                        @map("patient_profile_id") @db.Uuid
  psychologistProfileId String                        @map("psychologist_profile_id") @db.Uuid
  modality              Modality
  startsAt              DateTime                      @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime                      @map("ends_at") @db.Timestamptz(3)
  timezone              String                        @db.VarChar(80)
  status                AppointmentStatus             @default(SCHEDULED)
  cancellationReason    String?                       @map("cancellation_reason") @db.VarChar(500)
  createdAt             DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientProfile        PatientProfile                @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  psychologistProfile   PsychologistProfile           @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  requestLink           AppointmentRequest?
  careRelationshipLink  AppointmentCareRelationship?
  clinicalEncounterLink ClinicalEncounterAppointment?
  conversationLink      AppointmentConversation?
  review                Review?
  events                AppointmentEvent[]

  @@index([psychologistProfileId, startsAt])
  @@index([patientProfileId, startsAt])
  @@map("appointments")
}

model AppointmentEvent {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId    String               @map("appointment_id") @db.Uuid
  actorUserId      String               @map("actor_user_id") @db.Uuid
  type             AppointmentEventType
  fromStatus       AppointmentStatus?   @map("from_status")
  toStatus         AppointmentStatus    @map("to_status")
  previousStartsAt DateTime?            @map("previous_starts_at") @db.Timestamptz(3)
  previousEndsAt   DateTime?            @map("previous_ends_at") @db.Timestamptz(3)
  reason           String?              @db.VarChar(500)
  occurredAt       DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  appointment      Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  actor            User                 @relation("AppointmentEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([appointmentId, occurredAt, id])
  @@index([actorUserId, occurredAt])
  @@map("appointment_events")
}

model AppointmentRequest {
  appointmentId    String         @id @map("appointment_id") @db.Uuid
  serviceRequestId String         @unique @map("service_request_id") @db.Uuid
  appointment      Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@map("appointment_requests")
}

model AppointmentCareRelationship {
  appointmentId      String           @id @map("appointment_id") @db.Uuid
  careRelationshipId String           @map("care_relationship_id") @db.Uuid
  appointment        Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  careRelationship   CareRelationship @relation(fields: [careRelationshipId], references: [id], onDelete: Restrict)

  @@index([careRelationshipId])
  @@map("appointment_care_relationships")
}

model ClinicalRecord {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientProfileId String               @unique @map("patient_profile_id") @db.Uuid
  status           ClinicalRecordStatus @default(OPEN)
  openedAt         DateTime             @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt         DateTime?            @map("closed_at") @db.Timestamptz(3)
  patientProfile   PatientProfile       @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  encounters       ClinicalEncounter[]
  diagnoses        ClinicalDiagnosis[]
  treatmentPlans   TreatmentPlan[]

  @@map("clinical_records")
}

model ClinicalEncounter {
  id                    String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalRecordId      String                        @map("clinical_record_id") @db.Uuid
  psychologistProfileId String                        @map("psychologist_profile_id") @db.Uuid
  startedAt             DateTime                      @map("started_at") @db.Timestamptz(3)
  endedAt               DateTime?                     @map("ended_at") @db.Timestamptz(3)
  reason                String?                       @db.VarChar(500)
  clinicalRecord        ClinicalRecord                @relation(fields: [clinicalRecordId], references: [id], onDelete: Restrict)
  psychologistProfile   PsychologistProfile           @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  appointmentLink       ClinicalEncounterAppointment?
  notes                 ClinicalNote[]
  diagnosisSources      ClinicalDiagnosisSource[]

  @@index([clinicalRecordId, startedAt])
  @@map("clinical_encounters")
}

model ClinicalEncounterAppointment {
  clinicalEncounterId String            @id @map("clinical_encounter_id") @db.Uuid
  appointmentId       String            @unique @map("appointment_id") @db.Uuid
  clinicalEncounter   ClinicalEncounter @relation(fields: [clinicalEncounterId], references: [id], onDelete: Cascade)
  appointment         Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@map("clinical_encounter_appointments")
}

model ClinicalNote {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalEncounterId String                @map("clinical_encounter_id") @db.Uuid
  status              ClinicalNoteStatus    @default(DRAFT)
  signedAt            DateTime?             @map("signed_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  clinicalEncounter   ClinicalEncounter     @relation(fields: [clinicalEncounterId], references: [id], onDelete: Restrict)
  versions            ClinicalNoteVersion[]

  @@index([clinicalEncounterId, createdAt])
  @@map("clinical_notes")
}

model ClinicalNoteVersion {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalNoteId  String       @map("clinical_note_id") @db.Uuid
  versionNumber   Int          @map("version_number")
  authorUserId    String       @map("author_user_id") @db.Uuid
  content         String       @db.Text
  amendmentReason String?      @map("amendment_reason") @db.VarChar(500)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  clinicalNote    ClinicalNote @relation(fields: [clinicalNoteId], references: [id], onDelete: Restrict)
  author          User         @relation("ClinicalNoteVersionAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([clinicalNoteId, versionNumber])
  @@map("clinical_note_versions")
}

model DiagnosisCatalog {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeSystem String              @map("code_system") @db.VarChar(40)
  code       String              @db.VarChar(40)
  name       String              @db.VarChar(240)
  diagnoses  ClinicalDiagnosis[]

  @@unique([codeSystem, code])
  @@map("diagnosis_catalog")
}

model ClinicalDiagnosis {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalRecordId      String                   @map("clinical_record_id") @db.Uuid
  diagnosisCatalogId    String                   @map("diagnosis_catalog_id") @db.Uuid
  psychologistProfileId String                   @map("psychologist_profile_id") @db.Uuid
  status                DiagnosisStatus
  notes                 String?                  @db.Text
  diagnosedAt           DateTime                 @default(now()) @map("diagnosed_at") @db.Timestamptz(3)
  clinicalRecord        ClinicalRecord           @relation(fields: [clinicalRecordId], references: [id], onDelete: Restrict)
  diagnosisCatalog      DiagnosisCatalog         @relation(fields: [diagnosisCatalogId], references: [id], onDelete: Restrict)
  psychologistProfile   PsychologistProfile      @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  source                ClinicalDiagnosisSource?

  @@index([clinicalRecordId, diagnosedAt])
  @@map("clinical_diagnoses")
}

model ClinicalDiagnosisSource {
  clinicalDiagnosisId String            @id @map("clinical_diagnosis_id") @db.Uuid
  clinicalEncounterId String            @map("clinical_encounter_id") @db.Uuid
  clinicalDiagnosis   ClinicalDiagnosis @relation(fields: [clinicalDiagnosisId], references: [id], onDelete: Cascade)
  clinicalEncounter   ClinicalEncounter @relation(fields: [clinicalEncounterId], references: [id], onDelete: Restrict)

  @@index([clinicalEncounterId])
  @@map("clinical_diagnosis_sources")
}

model TreatmentPlan {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalRecordId      String              @map("clinical_record_id") @db.Uuid
  psychologistProfileId String              @map("psychologist_profile_id") @db.Uuid
  status                TreatmentPlanStatus @default(DRAFT)
  summary               String?             @db.Text
  startsAt              DateTime            @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime?           @map("ends_at") @db.Timestamptz(3)
  clinicalRecord        ClinicalRecord      @relation(fields: [clinicalRecordId], references: [id], onDelete: Restrict)
  psychologistProfile   PsychologistProfile @relation(fields: [psychologistProfileId], references: [id], onDelete: Restrict)
  goals                 TreatmentGoal[]

  @@index([clinicalRecordId, status])
  @@map("treatment_plans")
}

model TreatmentGoal {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  treatmentPlanId String              @map("treatment_plan_id") @db.Uuid
  description     String              @db.Text
  targetDate      DateTime?           @map("target_date") @db.Date
  status          TreatmentGoalStatus @default(PENDING)
  treatmentPlan   TreatmentPlan       @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)

  @@index([treatmentPlanId, status])
  @@map("treatment_goals")
}

model ConsentDocument {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @db.VarChar(80)
  version     String           @db.VarChar(30)
  title       String           @db.VarChar(200)
  contentHash String           @map("content_hash") @db.VarChar(128)
  publishedAt DateTime         @map("published_at") @db.Timestamptz(3)
  consents    PatientConsent[]

  @@unique([code, version])
  @@map("consent_documents")
}

model PatientConsent {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientProfileId  String          @map("patient_profile_id") @db.Uuid
  consentDocumentId String          @map("consent_document_id") @db.Uuid
  decision          ConsentDecision
  occurredAt        DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(3)
  ipAddress         String?         @map("ip_address") @db.Inet
  patientProfile    PatientProfile  @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  consentDocument   ConsentDocument @relation(fields: [consentDocumentId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, consentDocumentId, occurredAt])
  @@map("patient_consents")
}

model Conversation {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  requestLink     RequestConversation?
  appointmentLink AppointmentConversation?
  participants    ConversationParticipant[]

  @@map("conversations")
}

model RequestConversation {
  conversationId   String         @id @map("conversation_id") @db.Uuid
  serviceRequestId String         @unique @map("service_request_id") @db.Uuid
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@map("request_conversations")
}

model AppointmentConversation {
  conversationId String       @id @map("conversation_id") @db.Uuid
  appointmentId  String       @unique @map("appointment_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@map("appointment_conversations")
}

model ConversationParticipant {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?    @map("left_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages       Message[]

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id                        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId                  String?                 @unique @map("legacy_id")
  conversationParticipantId String                  @map("conversation_participant_id") @db.Uuid
  clientMessageId           String                  @map("client_message_id") @db.Uuid
  type                      MessageType             @default(TEXT)
  content                   String                  @db.Text
  sentAt                    DateTime                @default(now()) @map("sent_at") @db.Timestamptz(3)
  editedAt                  DateTime?               @map("edited_at") @db.Timestamptz(3)
  participant               ConversationParticipant @relation(fields: [conversationParticipantId], references: [id], onDelete: Restrict)

  @@unique([conversationParticipantId, clientMessageId])
  @@index([conversationParticipantId, sentAt, id])
  @@map("messages")
}

model Payment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId        String         @unique @map("offer_id") @db.Uuid
  amount         Decimal        @db.Decimal(12, 2)
  currencyCode   String         @map("currency_code") @db.Char(3)
  paymentMethod  String         @map("payment_method") @db.VarChar(50)
  transactionRef String         @unique @map("transaction_ref") @db.VarChar(100)
  status         PaymentStatus  @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  offer          Offer          @relation(fields: [offerId], references: [id], onDelete: Restrict)
  events         PaymentEvent[]

  @@index([status, createdAt])
  @@map("payments")
}

model PaymentEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId   String         @map("payment_id") @db.Uuid
  fromStatus  PaymentStatus? @map("from_status")
  toStatus    PaymentStatus  @map("to_status")
  externalRef String?        @map("external_ref") @db.VarChar(160)
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, occurredAt])
  @@map("payment_events")
}

model TriageAssessment {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientProfileId         String                   @map("patient_profile_id") @db.Uuid
  reviewedByPsychologistId String?                  @map("reviewed_by_psychologist_id") @db.Uuid
  provider                 String                   @db.VarChar(80)
  model                    String                   @db.VarChar(120)
  promptVersion            String                   @map("prompt_version") @db.VarChar(40)
  primaryNeed              String                   @map("primary_need") @db.VarChar(240)
  recommendedModality      Modality                 @map("recommended_modality")
  suggestedBudgetMin       Decimal                  @map("suggested_budget_min") @db.Decimal(12, 2)
  suggestedBudgetMax       Decimal                  @map("suggested_budget_max") @db.Decimal(12, 2)
  summary                  String                   @db.Text
  riskLevel                TriageRiskLevel          @map("risk_level")
  reviewedAt               DateTime?                @map("reviewed_at") @db.Timestamptz(3)
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  patientProfile           PatientProfile           @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  reviewedByPsychologist   PsychologistProfile?     @relation("TriageReviewer", fields: [reviewedByPsychologistId], references: [id], onDelete: Restrict)
  requestLink              RequestTriageAssessment?

  @@index([patientProfileId, createdAt])
  @@map("triage_assessments")
}

model RequestTriageAssessment {
  triageAssessmentId String           @id @map("triage_assessment_id") @db.Uuid
  serviceRequestId   String           @map("service_request_id") @db.Uuid
  triageAssessment   TriageAssessment @relation(fields: [triageAssessmentId], references: [id], onDelete: Cascade)
  serviceRequest     ServiceRequest   @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)

  @@index([serviceRequestId])
  @@map("request_triage_assessments")
}

model Review {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appointmentId String      @unique @map("appointment_id") @db.Uuid
  rating        Int         @db.SmallInt
  comment       String?     @db.VarChar(1000)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@map("reviews")
}

model AuditEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String   @map("resource_id") @db.Uuid
  requestId    String?  @map("request_id") @db.VarChar(100)
  ipAddress    String?  @map("ip_address") @db.Inet
  metadata     Json?
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_events")
}

model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateType  String    @map("aggregate_type") @db.VarChar(100)
  aggregateId    String    @map("aggregate_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(160)
  payload        Json
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(3)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  claimToken     String?   @map("claim_token") @db.Uuid
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(3)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.Text

  @@index([eventType, publishedAt, deadLetteredAt, availableAt, occurredAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
  actorUserId    String   @map("actor_user_id") @db.Uuid
  operation      String   @db.VarChar(80)
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  requestHash    String   @map("request_hash") @db.Char(64)
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  actor          User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@id([actorUserId, operation, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}
