{
  "name": "ruta-emocional-backend",
  "version": "1.0.0",
  "description": "Backend API REST & WebSockets para Ruta Emocional",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "npm run test:compile && node --test .test-dist/tests/unit/identity.unit.test.js .test-dist/tests/unit/professionalDirectory.unit.test.js .test-dist/tests/unit/serviceRequest.unit.test.js .test-dist/tests/unit/messaging.unit.test.js .test-dist/tests/unit/appointment.unit.test.js .test-dist/tests/unit/clinicalRecord.unit.test.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:integration": "npm run test:compile && node --test --test-concurrency=1 .test-dist/tests/integration/auth.integration.test.js .test-dist/tests/integration/professionalDirectory.integration.test.js .test-dist/tests/integration/serviceRequest.integration.test.js .test-dist/tests/integration/messagingSocket.integration.test.js .test-dist/tests/integration/appointment.integration.test.js .test-dist/tests/integration/clinicalRecord.integration.test.js .test-dist/tests/integration/health.integration.test.js",
    "db:format": "prisma format --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:status": "prisma migrate status --config prisma.config.ts",
    "local-qa:grant-admin": "node dist/scripts/grantLocalAdministrator.js"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^20.17.16",
    "prisma": "6.12.0",
    "socket.io-client": "^4.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
