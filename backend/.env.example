# Plantilla de variables de entorno para el backend. No incluir secretos reales.
PORT=5000
NODE_ENV=development

# Fuente de verdad. Usar un rol de aplicación con privilegios mínimos.
DATABASE_URL=postgresql://ruta_emocional_app:<password>@localhost:5432/ruta_emocional?schema=public

# Solo durante el proceso ETL y el periodo de reversión de la migración.
ENABLE_LEGACY_MONGO_ROUTES=false
MONGO_MIGRATION_URI=mongodb+srv://<user>:<password>@<cluster>/RutaEmocional
MONGO_MIGRATION_SEED_PASSWORD=<temporary_seed_password_of_at_least_12_characters>

# Valores aleatorios diferentes, de alta entropía y administrados fuera del repositorio.
JWT_ACCESS_SECRET=<at_least_32_random_characters>
PASSWORD_PEPPER=<at_least_32_other_random_characters>
JWT_ISSUER=ruta-emocional-api
JWT_AUDIENCE=ruta-emocional-app
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

PASSWORD_SCRYPT_N=32768
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=3
PASSWORD_SCRYPT_KEY_LENGTH=64

TRUST_PROXY=false
JSON_BODY_LIMIT=256kb
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8082
DIRECTORY_DEFAULT_PAGE_SIZE=20
DIRECTORY_MAX_PAGE_SIZE=50
DIRECTORY_MAX_RADIUS_KM=100
DIRECTORY_MAX_AVAILABILITY_WINDOW_DAYS=31
DIRECTORY_MAX_WEEKLY_RULES=50
DIRECTORY_PUBLIC_REQUESTS_PER_MINUTE=120
SUPPORTED_CURRENCIES=NIO
GEMINI_API_KEY=<replace_me>
