# Plantilla de variables de entorno para el backend. No incluir secretos reales.
PORT=5000
NODE_ENV=development

# Fuente de verdad. Usar un rol de aplicación con privilegios mínimos.
DATABASE_URL=postgresql://ruta_emocional_app:<password>@localhost:5432/ruta_emocional?schema=public

# Valores aleatorios diferentes, de alta entropía y administrados fuera del repositorio.
JWT_ACCESS_SECRET=<at_least_32_random_characters>
PASSWORD_PEPPER=<at_least_32_other_random_characters>
JWT_ISSUER=ruta-emocional-api
JWT_AUDIENCE=ruta-emocional-app
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

PASSWORD_SCRYPT_N=32768
PASSWORD_SCRYPT_R=8
PASSWORD_SCRYPT_P=3
PASSWORD_SCRYPT_KEY_LENGTH=64

TRUST_PROXY=false
JSON_BODY_LIMIT=256kb
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8082
DIRECTORY_DEFAULT_PAGE_SIZE=20
DIRECTORY_MAX_PAGE_SIZE=50
DIRECTORY_MAX_RADIUS_KM=100
DIRECTORY_MAX_AVAILABILITY_WINDOW_DAYS=31
DIRECTORY_MAX_WEEKLY_RULES=50
DIRECTORY_PUBLIC_REQUESTS_PER_MINUTE=120
SUPPORTED_CURRENCIES=NIO

# Flujo de evidencia estrictamente local para QA. Permanece apagado por defecto
# y la aplicación rechaza su activación fuera de NODE_ENV=development.
ENABLE_LOCAL_QA=false
LOCAL_QA_EVIDENCE_DIRECTORY=./var/private/professional-evidence
LOCAL_QA_EVIDENCE_MAXIMUM_BYTES=5242880
LOCAL_QA_EVIDENCE_UPLOADS_PER_MINUTE=5

# Reglas comerciales de solicitudes y ofertas. Son obligatorias y se validan al arrancar.
REQUEST_MINIMUM_AMOUNT=100.00
REQUEST_MAXIMUM_AMOUNT=10000.00
REQUEST_IMMEDIATE_TTL_MINUTES=30
REQUEST_SCHEDULED_LEAD_MINUTES=120
REQUEST_SCHEDULED_OFFER_CUTOFF_MINUTES=30
REQUEST_MAXIMUM_SCHEDULE_DAYS=90
REQUEST_LOCATION_RETENTION_HOURS=24
REQUEST_MAXIMUM_OPEN_IMMEDIATE=1
REQUEST_MAXIMUM_DESCRIPTION_LENGTH=2000
REQUEST_MAXIMUM_PRIMARY_NEED_LENGTH=240
REQUEST_MAXIMUM_OFFER_MESSAGE_LENGTH=500
REQUEST_DEFAULT_PAGE_SIZE=20
REQUEST_MAXIMUM_PAGE_SIZE=50
REQUEST_IDEMPOTENCY_TTL_HOURS=24
REQUEST_EXPIRATION_BATCH_SIZE=100
REQUEST_MUTATIONS_PER_MINUTE=60
REQUEST_SERIALIZABLE_MAX_RETRIES=3
REQUEST_SERIALIZABLE_RETRY_BASE_DELAY_MS=25

# Mensajería persistida y entrega en tiempo real.
MESSAGE_MAXIMUM_TEXT_LENGTH=4000
MESSAGE_DEFAULT_PAGE_SIZE=50
MESSAGE_MAXIMUM_PAGE_SIZE=100
MESSAGE_MUTATIONS_PER_MINUTE=60
MESSAGE_MAXIMUM_SOCKET_SUBSCRIPTIONS=50
SOCKET_AUTH_REVALIDATION_SECONDS=60
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=50
OUTBOX_CLAIM_TTL_SECONDS=30
OUTBOX_MAXIMUM_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY_MS=500
OUTBOX_READINESS_MAXIMUM_LAG_SECONDS=120

# Agenda segura. La duración y los límites son decisiones del servidor.
APPOINTMENT_DURATION_MINUTES=50
APPOINTMENT_SLOT_INTERVAL_MINUTES=10
APPOINTMENT_MINIMUM_LEAD_MINUTES=120
APPOINTMENT_MAXIMUM_HORIZON_DAYS=90
APPOINTMENT_PATIENT_CANCELLATION_NOTICE_MINUTES=60
APPOINTMENT_START_WINDOW_BEFORE_MINUTES=15
APPOINTMENT_MAXIMUM_CANCELLATION_REASON_LENGTH=500
APPOINTMENT_DEFAULT_PAGE_SIZE=20
APPOINTMENT_MAXIMUM_PAGE_SIZE=50
APPOINTMENT_MUTATIONS_PER_MINUTE=60
APPOINTMENT_IDEMPOTENCY_TTL_HOURS=24
APPOINTMENT_SERIALIZABLE_MAX_RETRIES=3
APPOINTMENT_SERIALIZABLE_RETRY_BASE_DELAY_MS=25
APPOINTMENT_REMINDER_MINUTES_BEFORE=1440,60

# Historia clínica. La clave debe ser de 32 bytes aleatorios codificados en base64.
# En producción se inyecta desde el gestor de secretos y se rota incrementando la versión.
CLINICAL_CONTENT_ENCRYPTION_KEYS=1:<base64_encoded_32_random_bytes>
CLINICAL_ACTIVE_CONTENT_ENCRYPTION_KEY_VERSION=1
CLINICAL_MAXIMUM_NOTE_LENGTH=20000
CLINICAL_MAXIMUM_ENCOUNTER_REASON_LENGTH=500
CLINICAL_MAXIMUM_TREATMENT_SUMMARY_LENGTH=5000
CLINICAL_MAXIMUM_GOAL_LENGTH=1000
CLINICAL_MAXIMUM_GOALS_PER_PLAN=20
CLINICAL_MINIMUM_AMENDMENT_REASON_LENGTH=10
CLINICAL_MAXIMUM_AMENDMENT_REASON_LENGTH=500
CLINICAL_MAXIMUM_ENCOUNTER_DURATION_MINUTES=480
CLINICAL_ENCOUNTER_FUTURE_SKEW_MINUTES=15
CLINICAL_DEFAULT_PAGE_SIZE=20
CLINICAL_MAXIMUM_PAGE_SIZE=50
CLINICAL_MUTATIONS_PER_MINUTE=60
CLINICAL_IDEMPOTENCY_TTL_HOURS=24
CLINICAL_SERIALIZABLE_MAX_RETRIES=3
CLINICAL_SERIALIZABLE_RETRY_BASE_DELAY_MS=25
